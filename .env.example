# OpenAI 호환 /v1/chat/completions의 /v1 앞까지 입력
INFERENCE_BASE_URL=http://localhost:8000
INFERENCE_MODEL=mock-cafe
# 로컬 모의 서버를 연결할 때만 mock. AWS는 live로 설정.
INFERENCE_MODE=mock
INFERENCE_API_KEY=
INFERENCE_TIMEOUT_SECONDS=45

# Kubernetes Redis 매니페스트: ss-k8s/apps/ss-be/redis.yaml
# 로컬 BE는 127.0.0.1, Kubernetes BE는 ConfigMap의 ss-redis 주소를 사용한다.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
CONVERSATION_TTL_SECONDS=86400
# HTTPS 배포 기본값. localhost HTTP는 local-ollama 프로필에서 false 처리한다.
SESSION_COOKIE_SECURE=true
